<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="scan_topic" default="/sensing/lidar/scan"/>
  <arg name="odometry_topic" default="/localization/kinematic_state"/>
  <arg name="control_cmd_topic" default="/control/command/control_cmd"/>
  <arg name="param_file" default="$(find-pkg-share lidar_rl_controller)/config/lidar_rl_node.param.yaml"/>
  <arg name="model_path" default="/aichallenge/ml_workspace/kart_rl/models/ppo_kart_lidar"/>
  <!-- Example: use a specific trained model
  <arg name="model_path" default="/aichallenge/ml_workspace/kart_rl/models/ppo_kart_lidar_20260902-115134/ppo_kart_lidar_policy.npz"/>
  -->

  <node pkg="lidar_rl_controller"
        exec="lidar_rl_controller_node.py"
        name="lidar_rl_controller_node"
        output="screen">
    <param from="$(var param_file)"/>
    <param name="model.path" value="$(var model_path)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="scan.topic" value="$(var scan_topic)"/>
    <param name="odometry.topic" value="$(var odometry_topic)"/>
    <param name="control.topic" value="$(var control_cmd_topic)"/>
  </node>
</launch>
