<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="simulation" default="true"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="max_target_velocity" default="0.0"/>
  <arg name="use_external_target_vel" default="false"/>
  <arg name="external_target_vel" default="0.0"/>
  <arg name="input_trajectory_topic" default="/planning/scenario_planning/trajectory"/>
  <arg name="control_cmd_topic" default="/control/command/control_cmd"/>
  <arg name="node_name" default="simple_pure_pursuit_node"/>
  <arg name="fixed_acceleration" default="-1.0"/>

  <let name="steering_tire_angle_gain_var" value="1.50" if="$(var simulation)"/>
  <let name="steering_tire_angle_gain_var" value="1.639" unless="$(var simulation)"/>
  <let name="control_delay_sec_var" value="0.20" if="$(var simulation)"/>
  <let name="control_delay_sec_var" value="0.30" unless="$(var simulation)"/>

  <node pkg="simple_pure_pursuit" exec="simple_pure_pursuit" name="$(var node_name)" output="screen">
    <param name="wheel_base" value="1.087"/>
    <param name="use_external_target_vel" value="$(var use_external_target_vel)"/>
    <param name="external_target_vel" value="$(var external_target_vel)"/>
    <param name="max_target_velocity" value="$(var max_target_velocity)"/>
    <param name="lookahead_gain" value="0.25"/>
    <param name="lookahead_min_distance" value="2.0"/>
    <param name="speed_proportional_gain" value="1.0"/>
    <param name="steering_tire_angle_gain" value="$(var steering_tire_angle_gain_var)"/>
    <param name="max_acceleration" value="3.0"/>
    <param name="fixed_acceleration" value="$(var fixed_acceleration)"/>
    <param name="control_delay_sec" value="$(var control_delay_sec_var)"/>
    <param name="max_steering_tire_angle" value="0.64"/>

    <remap from="input/kinematics" to="/localization/kinematic_state"/>
    <remap from="input/trajectory" to="$(var input_trajectory_topic)"/>
    <remap from="output/control_cmd" to="$(var control_cmd_topic)"/>
  </node>
</launch>
